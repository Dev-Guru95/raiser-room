# Copy to .env and fill in. Nothing here has a safe default in production, and
# the application refuses to start rather than invent one.

# ── required ────────────────────────────────────────────────────────────────

# Signs every object URL. Generate with: openssl rand -hex 32
#
# Changing it invalidates every download and upload link currently in flight —
# including links a counterparty is holding — so it is generated once and kept,
# not rotated casually. Nothing else is encrypted with it.
STORAGE_SECRET=

# The public origin, used to build absolute links in emails and share links.
# Without it, links are relative — which works in a browser and does not work in
# an email.
BASE_URL=https://raiseroom.app

# ── where state lives ───────────────────────────────────────────────────────
# Both default to /data in the container image, which is the mounted volume.

DATABASE_FILE=/data/raiseroom.db
STORAGE_DIR=/data/objects

# ── behind a proxy ──────────────────────────────────────────────────────────

# 1 only when something in front terminates TLS and sets X-Forwarded-For.
# With nothing in front, that header comes from the caller: believing it lets
# them pick their own rate-limit bucket, which makes the limit decoration.
# This cannot be worked out at runtime — the request looks identical either way.
TRUST_PROXY=1

# ── file storage on another host ────────────────────────────────────────────

# Only when uploads go to a bucket rather than back to this application. The
# browser PUTs the file straight there, and the content-security policy has to
# name the origin or the browser blocks it with nothing in the server log to
# explain why. One origin, scheme and host only.
# STORAGE_ORIGIN=https://files.raiseroom.app

# ── never set in production ─────────────────────────────────────────────────

# Loads the worked example. Refused outright when NODE_ENV=production: a
# deployment serving real companies has no business being able to create
# invented ones.
# DEMO_SEED=1
